# ==============================================================================
# SIET Ticket Platform - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Credentials (NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.json
credentials.json
*.pem
*.key
*.crt
*.pfx

# ------------------------------------------------------------------------------
# 2. SQLite / Local Database Files
# ------------------------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm
*.sql
*.dump

# ------------------------------------------------------------------------------
# 3. User Uploaded Files & Media Attachments
# ------------------------------------------------------------------------------
media/*
!media/.gitignore
!media/.gitkeep
media/ticket_attachments/*
!media/ticket_attachments/.gitkeep
media/uploads/*
!media/uploads/.gitkeep

# ------------------------------------------------------------------------------
# 4. Virtual Environments
# ------------------------------------------------------------------------------
venv/
win_venv/
env/
ENV/
.venv/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 5. Python Bytecode, Caches & Distribution
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 6. Django Static Root & Local Overrides
# ------------------------------------------------------------------------------
staticfiles/
static_root/
local_settings.py

# ------------------------------------------------------------------------------
# 7. IDE, Editor, Agent & OS Specific Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.pydevproject
.settings/
.history/
.agents/
.gemini/
scratch/

# OS Generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 8. Testing, Logs & Diagnostic Caches
# ------------------------------------------------------------------------------
*.log
logs/
.coverage
htmlcov/
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.hypothesis/
dump.rdb
